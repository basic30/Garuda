# Environment Configuration for Marine Oil Spill System

# Backend API
PORT=8000
HOST=0.0.0.0
ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/oil_spill_db

# Live AIS Stream API Key (from AISstream.io)
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Meteorological & Oceanographic Data APIs
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
CDS_API_KEY=your_era5_cds_api_key

# Machine Learning Paths
MODEL_CHECKPOINT_PATH=ml/checkpoints/best_model.pth

# Forcing Data Storage Path
FORCING_DATA_DIR=data/ocean
